# SafePrompt Gateway Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# Security & Decision Thresholds
# Risk scale: 0.00 to 1.00
DECISION_WARN_THRESHOLD=0.30
DECISION_BLOCK_THRESHOLD=0.70
MAX_PROMPT_LENGTH=10000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Persistence & Telemetry
DATABASE_URL=sqlite:///./safeprompt.db
LOG_PROMPT_PAYLOADS=false  # Privacy preserving: hash payloads by default, do not log raw prompts
